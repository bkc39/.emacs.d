#!/bin/sh
# Enable once per clone with:  git config core.hooksPath hooks
#
# 1. scripts/check-tree.sh rejects absolute home-directory paths.
# 2. The staged diff is matched against `deny-patterns' from the
#    untracked local.eld.  The patterns stay out of the repository, so
#    the denylist itself is never published.
set -eu
root=$(git rev-parse --show-toplevel)

"$root/scripts/check-tree.sh"

config="$root/local.eld"
[ -f "$config" ] || config="$HOME/.emacs.d/local.eld"

if [ -f "$config" ] && command -v emacs >/dev/null 2>&1; then
    EMACS_LOCAL_CONFIG="$config" emacs --batch -Q \
        -L "$root/elisp" -l local-config \
        --eval '(local-config-check-staged)'
fi
